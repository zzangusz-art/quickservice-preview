{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "node build.mjs --out .site/check --cname no && node tools/blog-ai/generate.mjs --check"
  },
  "deploy": {
    "startCommand": "node tools/serve.mjs --production --url https://xn--2j1bs9sn9b30bc55a.kr/",
